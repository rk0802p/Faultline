# Faultline Environment Configuration
# Copy this file to .env or export variables in your environment.

# Control Plane Server Bindings
FAULTLINE_HOST=127.0.0.1
FAULTLINE_PORT=8000
FAULTLINE_DATA_DIR=data

# Container Networking and Security Boundaries
# Set FAULTLINE_ALLOW_EXTERNAL=1 only inside containerized environments (Docker Compose)
# to permit binding on 0.0.0.0 for intra-container networking.
FAULTLINE_ALLOW_EXTERNAL=0

# Additional allowed destination hostnames for outbound HTTP scenario execution.
# Targets outside loopback and this list are rejected by the security policy.
FAULTLINE_ALLOWED_HOSTS=checkout-service,payment-provider,toxiproxy

# Test Targets and Microservices
CHECKOUT_HOST=127.0.0.1
CHECKOUT_PORT=8766
PAYMENT_HOST=127.0.0.1
PAYMENT_PORT=8767

# Optional Sidecar Infrastructure (Docker Compose)
TOXIPROXY_URL=http://127.0.0.1:8474
REDIS_URL=redis://127.0.0.1:6379/0

# Disable embedded checkout and payment simulators when running external services
FAULTLINE_NO_EMBEDDED_SERVICES=0
