{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Faultline: Run app (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline",
      "args": ["--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Run platform tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Debug CLI scenario (fixed)",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline.cli",
      "args": ["run", "--scenario", "payment-response-lost", "--implementation", "fixed", "--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Debug CLI scenario (vulnerable)",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline.cli",
      "args": ["run", "--scenario", "payment-response-lost", "--implementation", "vulnerable", "--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Debug current test file",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-p", "${fileBasename}", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Debug dashboard JavaScript",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8000/",
      "webRoot": "${workspaceFolder}/faultline/web"
    },
    {
      "name": "Faultline: Debug CLI Benchmark",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline.cli",
      "args": ["benchmark", "--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Debug CLI Suite (Critical Integrations - fixed)",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline.cli",
      "args": ["run", "--suite", "critical-integrations", "--implementation", "fixed", "--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Debug CLI Suite (Critical Integrations - vulnerable)",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline.cli",
      "args": ["run", "--suite", "critical-integrations", "--implementation", "vulnerable", "--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Debug Scenario 2 (Duplicate Webhook - fixed)",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline.cli",
      "args": ["run", "--scenario", "duplicate-payment-webhook", "--implementation", "fixed", "--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Debug Scenario 3 (Persistence Failure - fixed)",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline.cli",
      "args": ["run", "--scenario", "partial-persistence-failure", "--implementation", "fixed", "--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Debug CLI Report (Markdown)",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline.cli",
      "args": ["report", "--report-format", "markdown"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
