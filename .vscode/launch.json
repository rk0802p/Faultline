{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Faultline: Run app (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline",
      "args": ["--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Run platform tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Debug CLI scenario",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline.cli",
      "args": ["run", "--scenario", "payment-response-lost", "--implementation", "fixed"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Debug dashboard JavaScript",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8000/",
      "webRoot": "${workspaceFolder}/faultline/web"
    }
  ]
}
