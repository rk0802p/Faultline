{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Faultline: Run app (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "faultline",
      "args": ["--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Faultline: Run platform tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
